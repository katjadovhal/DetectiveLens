{
  "name": "detectivelens",
  "private": true,
  "version": "0.1.0",
  "description": "DetectiveLens — gamified misinformation literacy for children (LMU PSIS SS2026)",
  "workspaces": [
    "packages/*",
    "frontend",
    "personalization-engine"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev -w @detectivelens/frontend",
    "dev:backend": "cd backend && .venv/bin/python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 3001",
    "build": "npm run build --workspaces --if-present",
    "build:shared": "npm run build -w @detectivelens/shared",
    "db:init": "cd backend && python -m app.seed",
    "db:seed": "cd backend && python -m app.seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
